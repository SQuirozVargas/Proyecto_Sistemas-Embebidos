#include <stdio.h>
#include <stdlib.h>
#include "freertos/FreeRTOS.h"
#include "freertos/task.h"
#include "esp_adc/adc_oneshot.h" 
#include "esp_log.h"

static const char *TAG = "CALIBRACION_COJIN";

// 1. DEFINICIÓN DE PINES (ADC1 - COMPATIBLE CON ESP32-S)
#define CANAL_BLOQUE_IZQ ADC_CHANNEL_3 // GPIO 39 (Pin VN) -> 2 Piezos Izquierdos
#define CANAL_BLOQUE_DER ADC_CHANNEL_6 // GPIO 34           -> 2 Piezos Derechos

// 2. PARÁMETROS DE CALIBRACIÓN ROBUSTOS
#define RUIDO_REPOSO_MAX     4000  // Si ambos sensores superan esto, el asiento está libre
#define UMBRAL_DESBALANCE    1200  // Diferencia analógica real para notar la inclinación
#define TIEMPO_CRITICO_MS    1500  // Alerta rápida a 1.5 segundos para pruebas
#define PERIODO_MUESTREO_MS  10    // Muestreo base a 10ms

// Manejador del periférico ADC1
adc_oneshot_unit_handle_t adc1_handle;

void inicializar_adc(void) {
    adc_oneshot_unit_init_cfg_t init_config1 = {
        .unit_id = ADC_UNIT_1,
        .clk_src = ADC_DIGI_CLK_SRC_DEFAULT,
    };
    ESP_ERROR_CHECK(adc_oneshot_new_unit(&init_config1, &adc1_handle));

    adc_oneshot_chan_cfg_t config_canal = {
        .bitwidth = ADC_BITWIDTH_12,
        .atten = ADC_ATTEN_DB_12, 
    };
    
    ESP_ERROR_CHECK(adc_oneshot_config_channel(adc1_handle, CANAL_BLOQUE_IZQ, &config_canal));
    ESP_ERROR_CHECK(adc_oneshot_config_channel(adc1_handle, CANAL_BLOQUE_DER, &config_canal));
}

void app_main(void) {
    inicializar_adc();

    int peso_izq = 0;
    int peso_der = 0;
    
    // Contadores para ráfagas consecutivas (Lógica de alarma)
    int ciclos_inclinado_izq = 0;
    int ciclos_inclinado_der = 0;
    int ciclos_necesarios_desmayo = TIEMPO_CRITICO_MS / PERIODO_MUESTREO_MS;

    // --- NUEVAS VARIABLES: Contadores históricos acumulados en segundos ---
    float tiempo_total_izq_seg = 0.0;
    float tiempo_total_der_seg = 0.0;

    int contador_impresion = 0;
    bool alguien_sentado = false;

    ESP_LOGI(TAG, "Lógica con medición de tiempos acumulados inicializada.");

    while (1) {
        // A. Lectura directa de sensores
        adc_oneshot_read(adc1_handle, CANAL_BLOQUE_IZQ, &peso_izq);
        adc_oneshot_read(adc1_handle, CANAL_BLOQUE_DER, &peso_der);

        // B. Lógica de presencia inteligente
        if (peso_izq > RUIDO_REPOSO_MAX && peso_der > RUIDO_REPOSO_MAX) {
            alguien_sentado = false;
            ciclos_inclinado_izq = 0;
            ciclos_inclinado_der = 0;
        } else {
            alguien_sentado = true;
        }

        // C. Algoritmo de postura dinámico directo con acumulación de tiempo real
        if (alguien_sentado) {
            int diferencia_directa = peso_izq - peso_der;

            if (diferencia_directa > UMBRAL_DESBALANCE) {
                ciclos_inclinado_der++; 
                ciclos_inclinado_izq = 0;
                // Sumamos el tiempo de este ciclo (10ms = 0.01s) al histórico derecho
                tiempo_total_der_seg += ((float)PERIODO_MUESTREO_MS / 1000.0);
            } 
            else if (diferencia_directa < -UMBRAL_DESBALANCE) {
                ciclos_inclinado_izq++; 
                ciclos_inclinado_der = 0;
                // Sumamos el tiempo de este ciclo (10ms = 0.01s) al histórico izquierdo
                tiempo_total_izq_seg += ((float)PERIODO_MUESTREO_MS / 1000.0);
            } 
            else {
                ciclos_inclinado_izq = 0;
                ciclos_inclinado_der = 0;
            }
        }

        // D. Impresión en consola cada 200ms
        contador_impresion++;
        if (contador_impresion >= 20) {
            contador_impresion = 0;

            printf("\e[1;1H\e[2J"); 
            printf("=============================================================\n");
            printf("             MONITOR DE CALIBRACIÓN COMPARATIVO: PIEZOS       \n");
            printf("=============================================================\n");
            
            if (!alguien_sentado) {
                printf(" STATUS: [ VACÍO ]\n\n");
                printf("  IZQ: %d | DER: %d | Ambos en reposo.\n", peso_izq, peso_der);
                printf("+------------------------------------------------------------+\n");
                printf(" HISTÓRICO DE VIAJE:\n");
                printf("  Tiempo acumulado inclinado a la IZQ: %.2f segundos\n", tiempo_total_izq_seg);
                printf("  Tiempo acumulado inclinado a la DER: %.2f segundos\n", tiempo_total_der_seg);
                printf("+------------------------------------------------------------+\n");
                ESP_LOGW("COJÍN", "Asiento libre. Esperando conductor...");
                printf("=============================================================\n");
            } else {
                printf(" STATUS: [ OCUPADO ]\n\n");
                int diferencia_directa = peso_izq - peso_der;
                
                printf("+--------------------+--------------------+--------------------+\n");
                printf("| SENSOR IZQUIERDO   | SENSOR DERECHO     | DELTA DIRECTO      |\n");
                printf("+--------------------+--------------------+--------------------+\n");
                printf("| %-18d | %-18d | %-18d |\n", peso_izq, peso_der, diferencia_directa);
                printf("+--------------------+--------------------+--------------------+\n\n");

                printf(" HISTÓRICO DE VIAJE:\n");
                printf("  Tiempo acumulado inclinado a la IZQ: %.2f segundos\n", tiempo_total_izq_seg);
                printf("  Tiempo acumulado inclinado a la DER: %.2f segundos\n", tiempo_total_der_seg);
                printf("+------------------------------------------------------------+\n\n");

                printf(" DIAGNÓSTICO POSTURAL EN TIEMPO REAL:\n");
                
                if (ciclos_inclinado_izq >= ciclos_necesarios_desmayo) {
                    ESP_LOGE("COJÍN", "¡ALERTA CRÍTICA! CONDUCTOR CAÍDO A LA IZQUIERDA");
                } else if (ciclos_inclinado_der >= ciclos_necesarios_desmayo) {
                    ESP_LOGE("COJÍN", "¡ALERTA CRÍTICA! CONDUCTOR CAÍDO A LA DERECHA");
                } else {
                    if (diferencia_directa > UMBRAL_DESBALANCE) {
                        printf(" [!] Detectando inclinación DERECHA... Ráfaga: %d / %d ms\n", 
                               ciclos_inclinado_der * PERIODO_MUESTREO_MS, TIEMPO_CRITICO_MS);
                    } else if (diferencia_directa < -UMBRAL_DESBALANCE) {
                        printf(" [!] Detectando inclinación IZQUIERDA... Ráfaga: %d / %d ms\n", 
                               ciclos_inclinado_izq * PERIODO_MUESTREO_MS, TIEMPO_CRITICO_MS);
                    } else {
                        ESP_LOGI("COJÍN", "Postura correcta y centrada.");
                    }
                }
                printf("=============================================================\n");
            }
        }

        vTaskDelay(pdMS_TO_TICKS(PERIODO_MUESTREO_MS));
    }
}
