// ================== SIM900 ==================
#define SIM_RX_PIN            18
#define SIM_TX_PIN             5
#define SIM_BAUDRATE        9600
#define SIM_NUMERO_EMERGENCIA "+593963834144"
#define SIM_MAX_REINTENTOS     3
#define SIM_TIMEOUT_MS     15000

HardwareSerial simSerial(1);

enum EstadoSIM {
  SIM_IDLE, SIM_VERIFICANDO, SIM_ENVIANDO_SMS,
  SIM_ESPERANDO_OK, SIM_LISTO, SIM_ERROR
};

EstadoSIM     estadoSIM     = SIM_IDLE;
unsigned long tiempoSIM     = 0;
String        mensajeSIM    = "";
int           reintentosSIM = 0;

void simEnviarComando(const String& cmd) {
  simSerial.println(cmd);
  tiempoSIM = millis();
  Serial.println("[SIM] >> " + cmd);
}

String simLeerRespuesta() {
  String resp = "";
  unsigned long t = millis();
  while (millis() - t < 300)
    while (simSerial.available()) resp += (char)simSerial.read();
  if (resp.length() > 0) Serial.println("[SIM] << " + resp);
  return resp;
}

void simIniciarEnvio(const String& mensaje) {
  if (estadoSIM == SIM_ENVIANDO_SMS || estadoSIM == SIM_VERIFICANDO ||
      estadoSIM == SIM_ESPERANDO_OK) {
    Serial.println("[SIM] Envio ya en curso.");
    return;
  }
  mensajeSIM = mensaje; reintentosSIM = 0;
  estadoSIM  = SIM_VERIFICANDO;
  simEnviarComando("AT");
  Serial.println("[SIM] Iniciando envio por GSM.");
}

void simTick() {
  if (estadoSIM == SIM_IDLE || estadoSIM == SIM_LISTO || estadoSIM == SIM_ERROR) return;
  static unsigned long ultimoLogSIM = 0;
  if (millis() - ultimoLogSIM >= 2000) {
    ultimoLogSIM = millis();
    Serial.println("[SIM] Esperando... " + String(
      estadoSIM == SIM_VERIFICANDO  ? "VERIFICANDO"  :
      estadoSIM == SIM_ENVIANDO_SMS ? "ENVIANDO_SMS" :
      estadoSIM == SIM_ESPERANDO_OK ? "ESPERANDO_OK" : "?"
    ));
  }
  if (millis() - tiempoSIM > SIM_TIMEOUT_MS) {
    reintentosSIM++;
    if (reintentosSIM >= SIM_MAX_REINTENTOS) {
      estadoSIM = SIM_ERROR;
      Serial.println("[SIM] Fallo definitivo.");
      return;
    }
    estadoSIM = SIM_VERIFICANDO;
    simEnviarComando("AT");
    return;
  }
  if (!simSerial.available()) return;
  String resp = simLeerRespuesta();
  switch (estadoSIM) {
    case SIM_VERIFICANDO:
      if (resp.indexOf("OK") >= 0) { simEnviarComando("AT+CMGF=1"); estadoSIM = SIM_ENVIANDO_SMS; }
      break;
    case SIM_ENVIANDO_SMS:
      if (resp.indexOf("OK") >= 0) { simEnviarComando("AT+CMGS=\"" + String(SIM_NUMERO_EMERGENCIA) + "\""); estadoSIM = SIM_ESPERANDO_OK; }
      break;
    case SIM_ESPERANDO_OK:
      if (resp.indexOf(">")       >= 0) { simSerial.print(mensajeSIM); simSerial.write(0x1A); tiempoSIM = millis(); }
      if (resp.indexOf("SEND OK") >= 0) { estadoSIM = SIM_LISTO; reintentosSIM = 0; Serial.println("[SIM] SMS enviado."); }
      if (resp.indexOf("ERROR")   >= 0) {
        reintentosSIM++;
        if (reintentosSIM >= SIM_MAX_REINTENTOS) estadoSIM = SIM_ERROR;
        else { estadoSIM = SIM_VERIFICANDO; simEnviarComando("AT"); }
      }
      break;
    default: break;
  }
}

