import cv2
import time
import subprocess
from gpiozero import OutputDevice, Button

# Configurar el pin GPIO 17 como salida a la ESP32 (Inicia en LOW / 0V)
# Físicamente es el Pin 11 en el cabezal de la Raspberry Pi
pin_alerta = OutputDevice(17, initial_value=False)

# Configurar el pin GPIO 3 como botón de control multifunción
# Físicamente es el Pin 5. Conecta el botón entre el Pin 5 y GND (Pin 6)
# IMPORTANTE: El GPIO 3 es el único pin que permite encender la Pi estando apagada.
# bounce_time=0.2 añade un anti-rebote por software de 200 milisegundos
boton_control = Button(3, hold_time=3, bounce_time=0.2) 

sistema_activo = True
apagando = False

def iniciar_apagado():
    global apagando
    apagando = True
    print("\n=============================================")
    print("APAGANDO LA RASPBERRY PI DE FORMA SEGURA...")
    print("Espera a que el LED verde deje de parpadear.")
    print("Para volver a encender el sistema, solo presiona")
    print("este mismo botón una vez (estando conectada).")
    print("=============================================\n")
    pin_alerta.off()
    subprocess.call(['sudo', 'poweroff'])

def alternar_estado():
    global sistema_activo, apagando
    if not apagando:  # Evitamos acción si ya se ordenó el apagado
        sistema_activo = not sistema_activo
        if sistema_activo:
            print("\n[INFO] Sistema REANUDADO. Monitoreando fatiga...")
        else:
            print("\n[INFO] Sistema PAUSADO. Detección detenida.")
            pin_alerta.off()

# Asignar las acciones al botón físico
boton_control.when_held = iniciar_apagado
boton_control.when_released = alternar_estado

# Cargar los modelos de detección
face_cascade = cv2.CascadeClassifier('haarcascade_frontalface_default.xml')
eye_cascade = cv2.CascadeClassifier('haarcascade_eye.xml')

print("Iniciando cámara con configuración directa (V4L2, MJPG, 640x480)...")
cap = cv2.VideoCapture(0, cv2.CAP_V4L2)
cap.set(cv2.CAP_PROP_FOURCC, cv2.VideoWriter_fourcc(*'MJPG'))
cap.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)
cap.set(cv2.CAP_PROP_BUFFERSIZE, 1)  # Evitar atasco de fotogramas

if not cap.isOpened():
    print("ERROR: No se pudo iniciar la cámara. Revisa la conexión USB.")
    exit()

print("Sistema SafeShot Iniciado.")
print(" -> Toque corto al botón: Pausar / Reanudar detección")
print(" -> Mantener 3 seg: Apagar la Raspberry de forma segura")

# Variables para control de tiempo exacto
tiempo_inicio_alerta = None
TIEMPO_ALARMA_SEGUNDOS = 5.0

try:
    while True:
        ret, frame = cap.read()
        if not ret:
            break
            
        if not sistema_activo:
            # Si el sistema está pausado, leemos la cámara para vaciar el buffer
            # pero no procesamos la imagen para ahorrar CPU
            tiempo_inicio_alerta = None
            time.sleep(0.1)
            continue

        # Convertir a escala de grises
        gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
        faces = face_cascade.detectMultiScale(gray, scaleFactor=1.3, minNeighbors=5)

        ojos_abiertos_confirmados = False

        if len(faces) > 0:
            # Si hay varios rostros en cuadro, nos quedamos con el mas grande
            x, y, w, h = max(faces, key=lambda f: f[2] * f[3])

            # Recortar la mitad superior del rostro para buscar los ojos
            roi_ojos = gray[y : y + int(h / 2), x : x + w]
            eyes = eye_cascade.detectMultiScale(roi_ojos, scaleFactor=1.1, minNeighbors=7, minSize=(15, 15))

            if len(eyes) > 0:
                ojos_abiertos_confirmados = True

        if ojos_abiertos_confirmados:
            # Ojos abiertos y confirmados: reiniciar cronometro y apagar señal
            if tiempo_inicio_alerta is not None:
                print("[+] Ojos abiertos. Cronómetro y alerta reiniciados.")
            tiempo_inicio_alerta = None
            pin_alerta.off()
        else:
            # No hay evidencia de ojos abiertos
            if tiempo_inicio_alerta is None:
                tiempo_inicio_alerta = time.time()
            else:
                tiempo_transcurrido = time.time() - tiempo_inicio_alerta
                motivo = "Ojos cerrados" if len(faces) > 0 else "Rostro no detectado"
                print(f"[*] {motivo}: {tiempo_transcurrido:.1f}s / {TIEMPO_ALARMA_SEGUNDOS}s")

                if tiempo_transcurrido >= TIEMPO_ALARMA_SEGUNDOS:
                    pin_alerta.on()
                    print("\n=============================================")
                    print(f"¡ALERTA! POSIBLE SOMNOLENCIA - Motivo: {motivo} - SEÑAL HIGH ENVIADA")
                    print("=============================================\n")

        time.sleep(0.05)

except KeyboardInterrupt:
    print("\nDeteniendo sistema...")
finally:
    # Asegurarnos de apagar el pin y la cámara al salir
    pin_alerta.off()
    if cap is not None:
        cap.release()
    print("Recursos liberados.")
