import cv2
import time
from gpiozero import OutputDevice

# Configurar el pin GPIO 17 como salida (Inicia en LOW / 0V por defecto)
# Físicamente es el Pin 11 en el cabezal de la Raspberry Pi
pin_alerta = OutputDevice(17, initial_value=False)

# Cargar los modelos de detección
face_cascade = cv2.CascadeClassifier('haarcascade_frontalface_default.xml')
eye_cascade = cv2.CascadeClassifier('haarcascade_eye.xml')

print("Iniciando cámara con configuración directa (V4L2, MJPG, 640x480)...")
cap = cv2.VideoCapture(0, cv2.CAP_V4L2)
cap.set(cv2.CAP_PROP_FOURCC, cv2.VideoWriter_fourcc(*'MJPG'))
cap.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)
cap.set(cv2.CAP_PROP_BUFFERSIZE, 1) # Evitar atasco de fotogramas

if not cap.isOpened():
    print("ERROR: No se pudo iniciar la cámara. Revisa la conexión USB.")
    exit()

print("Sistema SafeShot Iniciado. Monitoreando fatiga... Presiona Ctrl+C para detener.")

# Variables para control de tiempo exacto
tiempo_inicio_cierre = None
TIEMPO_ALARMA_SEGUNDOS = 5.0

try:
    while True:
        ret, frame = cap.read()
        if not ret:
            break

        # Convertir a escala de grises
        gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
        faces = face_cascade.detectMultiScale(gray, scaleFactor=1.3, minNeighbors=5)
        
        rostro_detectado = False

        for (x, y, w, h) in faces:
            rostro_detectado = True
            
            # Recortar la mitad superior del rostro para buscar los ojos
            roi_ojos = gray[y : y + int(h/2), x : x + w]
            eyes = eye_cascade.detectMultiScale(roi_ojos, scaleFactor=1.1, minNeighbors=7, minSize=(15, 15))

            if len(eyes) == 0:
                # Los ojos están cerrados o no se ven
                if tiempo_inicio_cierre is None:
                    # Iniciar el cronómetro en este instante
                    tiempo_inicio_cierre = time.time()
                else:
                    # Calcular cuánto tiempo ha pasado
                    tiempo_transcurrido = time.time() - tiempo_inicio_cierre
                    print(f"[*] Ojos cerrados: {tiempo_transcurrido:.1f}s / {TIEMPO_ALARMA_SEGUNDOS}s")
                    
                    if tiempo_transcurrido >= TIEMPO_ALARMA_SEGUNDOS:
                        # Si superan los 5 segundos, enviar 1 (HIGH) por el GPIO
                        pin_alerta.on()
                        print("\n=============================================")
                        print("¡ALERTA! CONDUCTOR DORMIDO - SEÑAL HIGH ENVIADA")
                        print("=============================================\n")
            else:
                # Ojos abiertos: reiniciar cronómetro y apagar señal (LOW)
                if tiempo_inicio_cierre is not None:
                    print("[+] Ojos abiertos. Cronómetro y alerta reiniciados.")
                tiempo_inicio_cierre = None
                pin_alerta.off()

        # Si perdemos el rostro por completo, apagamos la alerta por seguridad
        if not rostro_detectado:
            tiempo_inicio_cierre = None
            pin_alerta.off()

        time.sleep(0.05) 

except KeyboardInterrupt:
    print("\nDeteniendo sistema...")
finally:
    # Asegurarnos de apagar el pin y la cámara al salir
    pin_alerta.off()
    if cap is not None:
        cap.release()
    print("Recursos liberados.")
